Intermediate/ 
Saved/ 
Binaries/ 
Build/ 
DerivedDataCache/ 
*.sln 
*.suo 
*.opensdf 
*.sdf 

# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/
Plugins/*/Binaries/

# Builds
Build/

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/

# Compiled source files for the engine to use
Intermediate/
Plugins/*/Intermediate/

# Cache files for the editor to use
DerivedDataCache/

# Never ignore git files
!.gitignore
!.gitattributes
# Session transcripts
transcript.txt

# Generated per-machine by UnrealBuildTool project generation
.vscode/compileCommands_*

# The room library holds BOTH derived data and authored source, in the same folder by design.
#
# DERIVED -- ignored. The bake regenerates BP_Room_* and DA_Room_* wholesale, one piece per
# exit, at ~1.1 MB of LFS each. Two 4.5 MB commits landed by accident before this rule covered
# every room type rather than just Generic/.
#
# SOURCE -- tracked. DA_RoomRecipe_* is what the author saves and re-opens; it is the room.
# Do NOT widen this to the whole folder, which is the obvious-looking change that loses it.
Content/RectDungeon/Rooms/**/BP_Room_*
Content/RectDungeon/Rooms/**/DA_Room_*
